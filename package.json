{
  "name": "type-racer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "types": "wrangler types --env-interface CloudflareBindings worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy:worker": "wrangler deploy",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build && npm run build:worker",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0",
    "ws": "8.22.0"
  }
}
